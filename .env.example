# 高德地图 Web 端（JS API）Key
AMAP_JS_KEY=

# 高德地图安全密钥，仅在服务端使用
AMAP_SECURITY_CODE=

# OpenAI API，仅服务端使用，不得写入前端或提交真实值
OPENAI_API_KEY=

# 可选；不填写时使用 gpt-5.6-sol
OPENAI_CASE_PARSER_MODEL=gpt-5.6-sol

# 基础案例解析服务商：deepseek（低成本默认）、qwen、gemini 或 openai
AI_CASE_PARSER_PROVIDER=deepseek

# DeepSeek API，仅服务端使用；基础解析默认使用
DEEPSEEK_API_KEY=

# 可选；不填写时使用 deepseek-v4-flash
DEEPSEEK_CASE_PARSER_MODEL=deepseek-v4-flash

# 阿里云百炼华北2（北京）API Key，仅服务端使用；联网研究默认使用
DASHSCOPE_API_KEY=

# 可选；不填写时使用 qwen-plus
QWEN_CASE_PARSER_MODEL=qwen-plus

# 千问联网检索策略：turbo（低成本默认）或 max
QWEN_SEARCH_STRATEGY=turbo

# Gemini API，仅服务端使用，不得写入前端或提交真实值
GEMINI_API_KEY=

# 可选；用于无法本地提取文字的扫描PDF
GEMINI_CASE_PARSER_MODEL=gemini-3.5-flash
