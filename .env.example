# 高德地图 Web 端（JS API）Key
AMAP_JS_KEY=

# 高德地图安全密钥，仅在服务端使用
AMAP_SECURITY_CODE=

# OpenAI API，仅服务端使用，不得写入前端或提交真实值
OPENAI_API_KEY=

# 可选；不填写时使用 gpt-5.6-sol
OPENAI_CASE_PARSER_MODEL=gpt-5.6-sol

# 基础案例解析服务商：deepseek（低成本默认）、qwen、gemini 或 openai
AI_CASE_PARSER_PROVIDER=deepseek

# DeepSeek API，仅服务端使用；基础解析默认使用
DEEPSEEK_API_KEY=

# 可选；不填写时使用 deepseek-v4-flash
DEEPSEEK_CASE_PARSER_MODEL=deepseek-v4-flash

# 联网研究服务商：tavily（低成本默认）、zhipu、tencent_wsa 或 qwen
AI_CASE_RESEARCH_PROVIDER=tavily

# Tavily API Key，仅服务端使用；默认每个案例最多执行2次 Basic Search
TAVILY_API_KEY=

# 智谱AI开放平台 API Key，仅服务端使用；备用
ZHIPU_API_KEY=

# 腾讯云联网搜索 API 服务密钥，仅服务端使用；备用
WSA_API_KEY=

# 阿里云百炼华北2（北京）API Key，仅服务端使用；切换为 qwen 联网研究时使用
DASHSCOPE_API_KEY=

# 可选；不填写时使用 qwen-plus
QWEN_CASE_PARSER_MODEL=qwen-plus

# 千问联网检索策略：turbo（低成本默认）或 max
QWEN_SEARCH_STRATEGY=turbo

# Gemini API，仅服务端使用，不得写入前端或提交真实值
GEMINI_API_KEY=

# 可选；用于无法本地提取文字的扫描PDF
GEMINI_CASE_PARSER_MODEL=gemini-3.5-flash

# 可选；主模型繁忙时自动切换的扫描PDF备用模型
GEMINI_CASE_PARSER_FALLBACK_MODEL=gemini-3.5-flash-lite
